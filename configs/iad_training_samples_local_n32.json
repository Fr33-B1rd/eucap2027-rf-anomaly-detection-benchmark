{
  "protocol_version": "iad-training-samples-local-pilot-n32-v1",
  "dataset_dir": "Datasets/IAD",
  "protocol": {
    "normal_reference_source": "CHIRP",
    "normal_test_source": "CHIRP",
    "anomaly_conditions": ["16QAM", "CHIRP", "GMSK", "QPSK"],
    "normal_usage": "seeded_nested_reference_subset_for_fitting",
    "normal_train_budget": 32,
    "held_out_calibration": false,
    "expected_counts": {
      "normal_reference": 4388,
      "normal_test": 788,
      "anomaly_per_condition": 774
    }
  },
  "matrix": {
    "gpu_methods": ["patchcore", "cflow", "vae_per"],
    "cpu_methods": [],
    "seeds": [2026]
  },
  "evaluation": {
    "partial_auc_max_fpr": 0.01,
    "bootstrap_samples": 2000,
    "save_fit_reference_scores": true
  },
  "methods": {
    "patchcore": {
      "batch_size": 16,
      "input_size": 64,
      "backbone": "wide_resnet50_2",
      "layers": ["layer2", "layer3"],
      "sample_patches_per_image": 32,
