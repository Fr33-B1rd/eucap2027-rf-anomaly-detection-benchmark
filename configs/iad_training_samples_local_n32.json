      "coreset_ratio": 0.1,
      "max_memory_bank_size": 3000,
      "projection_dim": 128,
      "query_chunk_size": 4096
    },
    "cflow": {
      "input_size": 64,
      "train_batch_size": 32,
      "score_batch_size": 64,
      "backbone": "wide_resnet50_2",
      "pool_layers": 3,
      "coupling_blocks": 8,
      "condition_vector_dim": 128,
      "clamp_alpha": 1.9,
      "fiber_batch_size": 128,
      "meta_epochs": 25,
      "sub_epochs": 8,
      "lr": 0.0002,
      "lr_decay_rate": 0.1,
      "lr_warm_epochs": 2,
      "checkpoint_every_meta_epochs": 5,
      "keep_checkpoint_after_success": false
    },
    "vae_per": {
      "batch_size": 64,
      "input_size": 64,
      "epochs": 1000,
      "lr": 0.0001,
      "latent_dim": 75,
      "kl_weight": 0.1
    }
  },
  "assets": {},
  "save_scores": true
}
