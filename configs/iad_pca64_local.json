{
  "protocol_version": "iad-pca64-local-v1",
  "dataset_dir": "Datasets/IAD",
  "matrix": {
    "methods": ["pca_reconstruction"],
    "modulations": ["16QAM", "CHIRP", "GMSK", "QPSK"],
    "seeds": [2026, 2027, 2028, 2029, 2030]
  },
  "evaluation": {
    "calibration_fraction": 0.2,
    "threshold_quantile": 0.95,
    "bootstrap_samples": 2000
  },
  "pca": {
    "input_size": 64,
    "preprocessing_profile": "iad_native_x10",
    "n_components": 64,
    "svd_solver": "randomized",
    "iterated_power": 4,
    "score": "mean_squared_reconstruction_error",
    "score_batch_size": 512
  },
  "save_scores": true
}
